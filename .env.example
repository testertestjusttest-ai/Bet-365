NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only sports feed configuration
SPORTS_FEED_API_KEY=
SPORTS_FEED_REGION=eu
SPORTS_FEED_MARKETS=h2h,spreads,totals
SPORTS_FEED_SPORTS=auto
SPORTS_FEED_BOOKMAKER=
# Optional comma-separated provider market keys loaded when opening an event. Empty = provider-discovered first set.
SPORTS_FEED_DETAIL_MARKETS=
SUPABASE_SERVICE_ROLE_KEY=
FEED_SYNC_SECRET=
CRON_SECRET=

# Server-only payment readiness configuration
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RECONCILIATION_SECRET=

# Keep false until the real-money deployment gate is completed.
REAL_MONEY_ENABLED=false

SPORTS_FEED_FREE_MODE=true
NEXT_PUBLIC_LIVE_AUTO_REFRESH=false
# Optional server-only casino aggregator catalog/sandbox configuration
# Use an sk_test_* key for sandbox/testing. Keep this server-side; never expose it as NEXT_PUBLIC_*.
AGGREGATOR_API_KEY=
AGGREGATOR_API_BASE_URL=https://api.aggregator.gg/v1
AGGREGATOR_CURRENCY=USD
AGGREGATOR_COUNTRY=BD
AGGREGATOR_SUB_OPERATOR_REF=
